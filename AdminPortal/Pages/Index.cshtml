@page
@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to the Admin Portal</h1>
    <p>Pharmacy Shop</p>
</div>


<!-- USERS -->

<div class="mt-4">
    <h2>Users</h2>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>User ID</th>
                <th>Username</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Address</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.UserName</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.UserEmail</td>
                    <td>@user.UserAddress</td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- CUSTOMERS -->

<div class="mt-4">
    <h2>Customers</h2>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Customer ID</th>
                <th>User ID</th>
                <th>Username</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Age</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var customer in Model.Customers)
            {
                <tr>
                    <td>@customer.CustomerId</td>
                    <td>@customer.UserId</td>
                    <td>@customer.User.UserName</td>
                    <td>@customer.User.FirstName</td>
                    <td>@customer.User.LastName</td>
                    <td>@customer.Age</td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- ADMINS -->

<div class="mt-4">
    <h2>Admins</h2>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Admin ID</th>
                <th>User ID</th>
                <th>Username</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var admin in Model.Admins)
            {
                <tr>
                    <td>@admin.AdminId</td>
                    <td>@admin.UserId</td>
                    <td>@admin.User.UserName</td>
                    <td>@admin.User.FirstName</td>
                    <td>@admin.User.LastName</td>
                    <td>@admin.User.UserEmail</td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- PRODUCTS -->

<div class="mt-4">
    <h2>Products</h2>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Stock</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.ProductId</td>
                    <td>@product.ProductName</td>
                    <td>@product.Description</td>
                    <td>@product.ProductPrice.ToString("0.00")</td>
                    <td>@product.QuantityInStock</td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- ORDERS -->

<div class="mt-4">
    <h2>Orders</h2>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer ID</th>
                <th>Customer First Name</th>
                <th>Customer Last Name</th>
                <th>Order Date</th>
                <th>Order Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.CustomerId</td>
                    <td>@order.Customer.User.FirstName</td>
                    <td>@order.Customer.User.LastName</td>
                    <td>@order.OrderDate</td>
                    <td>@order.OrderStatus</td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- ORDER DETAILS -->

<div class="mt-4">
    <h2>Order Details</h2>

    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Detail ID</th>
                <th>Order ID</th>
                <th>Product ID</th>
                <th>Product Name</th>
                <th>Amount</th>
                <th>Total Price</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var detail in Model.OrderDetails)
            {
                <tr>
                    <td>@detail.DetailId</td>
                    <td>@detail.OrderId</td>
                    <td>@detail.ProductId</td>
                    <td>@detail.Product.ProductName</td>
                    <td>@detail.Amount</td>
                    <td>@detail.TotalPrice.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
</div>