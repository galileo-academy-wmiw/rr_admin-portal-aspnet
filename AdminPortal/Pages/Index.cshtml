@page
@model IndexModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="text-center mb-5">
    <h1 class="display-4">Admin Dashboard</h1>
    <p>Pharmacy Shop</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Products</h2>
                <p class="card-text">Manage products in the pharmacy shop.</p>
                <a asp-page="/Products/Index" class="btn btn-primary">View Products</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Customers</h2>
                <p class="card-text">View customer information.</p>
                <a asp-page="/Customers/Index" class="btn btn-primary">View Customers</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="card-title">Orders</h2>
                <p class="card-text">View and manage customer orders.</p>
                <a asp-page="/Orders/Index" class="btn btn-primary">View Orders</a>
            </div>
        </div>
    </div>
</div>