@page "{id:int}"
@model AdminPortal.Pages.Products.DeleteModel

@{
    ViewData["Title"] = "Delete product";
}

<h1>Delete product</h1>

<p>The following product will be deleted.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <table class="table table-bordered">
        <tr>
            <th>ID</th>
            <td>@Model.Product.ProductId</td>
        </tr>
        <tr>
            <th>Name</th>
            <td>@Model.Product.ProductName</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>@Model.Product.Description</td>
        </tr>
        <tr>
            <th>Price</th>
            <td>€ @Model.Product.ProductPrice.ToString("0.00")</td>
        </tr>
        <tr>
            <th>Quantity in Stock</th>
            <td>@Model.Product.QuantityInStock</td>
        </tr>
    </table>

<p>This action cannot be reversed. Are you sure you want to delete this product? </p>

    <button type="submit" class="btn btn-danger">Delete product</button>
    <a asp-page="/Products/Index" class="btn btn-secondary">Back</a>
</form>
